name = "Luna-Flow/geometry3d"

version = "0.2.0"

import {
  "moonbitlang/x@0.4.43",
  "Luna-Flow/luna-generic@0.3.0",
  "Luna-Flow/linear-algebra@0.2.12",
}

readme = "README.md"

