msgstr ""

#: manual/api/core.md:32
msgid "`vec_length(v)`: computes Euclidean length."
msgstr ""

#: manual/api/core.md:33
msgid "`normalize_vec(v)`: returns a unit vector or zero vector for near-zero input."
msgstr ""

#: manual/api/core.md:35
msgid "Face Helpers"
msgstr ""

#: manual/api/core.md:37
msgid "`face_center(vertices, face)`: average of the four face vertices."
msgstr ""

#: manual/api/core.md:38
msgid "`face_normal(vertices, face)`: normalized cross product from the first three face vertices."
msgstr ""

#: manual/api/core.md:39
#, fuzzy
msgid "`face_is_visible(vertices, face, camera_position)`: backface test using `normal dot to_camera`."
msgstr "`face_is_visible`：`normal dot to_camera` 背面剔除判断。"

