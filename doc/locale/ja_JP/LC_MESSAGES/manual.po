msgid "`cross_vec(a, b)`: computes a 3D cross product."
msgstr ""

#: manual/api/core.md:32
msgid "`vec_length(v)`: computes Euclidean length."
msgstr ""

#: manual/api/core.md:33
msgid "`normalize_vec(v)`: returns a unit vector or zero vector for near-zero input."
msgstr ""

#: manual/api/core.md:35
msgid "Face Helpers"
msgstr ""

